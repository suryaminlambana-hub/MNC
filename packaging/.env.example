# ============================================================
# AUSY — konfigurasi runtime. Salin jadi .env:  cp .env.example .env
# Nilai di bawah cocok dengan setup-db.sql (tinggal pakai).
# ============================================================

# Port HTTP aplikasi (buka http://localhost:<SERVER_PORT><CONTEXT_PATH>)
SERVER_PORT=8080
# Context path aplikasi (sesuai Tech Doc). Kosongkan (CONTEXT_PATH=) untuk akses di root.
CONTEXT_PATH=/ausy

# Koneksi PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ausy
DB_USER=ausy_user
DB_PASS=ausy_pass_2026

# Direktori tujuan file ACCTXT. Kalau FTP server-nya ada di mesin yang sama, arahkan ke
# root FTP-nya dan JANGAN isi FTP_* di bawah — file langsung ditulis di sana (BUG_AUSY_00146).
AUSY_EXPORT_DIR=

# Transfer-out GLTRRF ke server FTP/FTPS LAIN (opsional). Diisi di sini, bukan lewat website.
# Kosongkan FTP_HOST untuk mematikan (file GLTRRF tetap dibuat lokal di AUSY_EXPORT_DIR).
# FTP_DIR = folder DI SERVER FTP (mis. /gl), bukan path lokal Windows.
# Kalau FTP_HOST diisi, nilainya menang atas baris tabel ftp_config peninggalan layar lama.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_DIR=
FTP_SECURE=false
FTP_PASSIVE=true
