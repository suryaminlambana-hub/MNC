# ============================================================
# AUSY — konfigurasi runtime. Salin jadi .env:  cp .env.example .env
# Nilai di bawah cocok dengan setup-db.sql (tinggal pakai).
# ============================================================

# Port HTTP aplikasi (buka http://localhost:<SERVER_PORT><CONTEXT_PATH>)
SERVER_PORT=8080
# Context path aplikasi (sesuai Tech Doc). Kosongkan (CONTEXT_PATH=) untuk akses di root.
CONTEXT_PATH=/ausy

# Koneksi PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ausy
DB_USER=ausy_user
DB_PASS=ausy_pass_2026

# Folder tempat file ACCTXT hasil export dibuat di mesin ini — PATH ABSOLUT. Core banking
# mengambil file dari folder ini, jadi arahkan ke root FTP lokalnya (mis. C:/inetpub/ftproot
# atau /srv/ftp). Pakai garis miring / walau di Windows.
# Kosong / tidak bisa dipakai = bawaan C:/inetpub/ftproot (Windows) atau data/txt (OS lain).
# Folder yang berlaku disebut di log saat start: "File hasil export ditulis ke ...".
AUSY_EXPORT_DIR=

# Server FTP tujuan file ACCTXT (core banking mengambil dari sana). Setelah ditulis ke folder di
# atas, file langsung dikirim ke sini. FTP_HOST kosong = tidak dikirim, cukup folder lokal.
# FTP_DIR kosong = folder awal user FTP.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_DIR=

# REQ_AUSY_00060 — login berakhir setelah sekian lama tanpa aktivitas (format 10m, 600s, ...).
AUSY_SESSION_IDLE=10m

# REQ_AUSY_00058 — scheduler Generate File ACCTXT Hari Ini lewat ausy-trigger.jar (jadwalnya diatur sendiri
# di crontab, lihat README.txt). Isi token rahasia yang panjang dan acak, mis. hasil
#   openssl rand -hex 24
# Kosong = scheduler dimatikan. AUSY_TRIGGER_URL dibaca ausy-trigger.jar (bawaan
# http://127.0.0.1:8080/ausy); tidak perlu diisi bila JAR dijalankan di server yang sama.
AUSY_TRIGGER_TOKEN=
AUSY_TRIGGER_URL=
# Penjadwal bawaan di dalam aplikasi (jam 23:00). Bawaan mati: jadwal diatur lewat JAR di atas.
AUSY_SCHEDULER_ENABLED=false

# REQ_AUSY_00072 — atribut SameSite cookie sesi: lax (bawaan) atau strict.
# AUSY_COOKIE_SAMESITE=lax
