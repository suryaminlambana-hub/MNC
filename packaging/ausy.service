# ============================================================
# AUSY — systemd unit (app server). Pasang di /etc/systemd/system/ausy.service
#   sudo cp ausy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ausy
#   sudo systemctl status ausy          # cek
#   sudo journalctl -u ausy -f          # log berjalan
# Sesuaikan User= dan path JAR bila folder instalasinya berbeda.
# ============================================================
[Unit]
Description=AUSY - MNC Bank Accounting Upload System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ausy
# PERIKSA grup nyatanya sebelum memasang: di server DEV MNC user "ausy" bergrup "users",
# dan nilai yang salah membuat service gagal dengan status=216/GROUP (deploy 4 Sep 2026).
#   sudo sed -i "s/^Group=.*/Group=$(id -gn ausy)/" /etc/systemd/system/ausy.service
Group=ausy
WorkingDirectory=/opt/ausy
# Konfigurasi (port, context path, koneksi DB) dibaca dari /opt/ausy/.env
EnvironmentFile=/opt/ausy/.env
ExecStart=/usr/bin/java -jar /opt/ausy/ausy-2.0.0.jar
SuccessExitStatus=143
# Dipilih always, bukan on-failure: penjadwal ACCTXT jam 23:00 hanya menyala kalau proses ini
# hidup, jadi berhenti dengan alasan apa pun — termasuk keluar normal — harus dihidupkan lagi.
Restart=always
RestartSec=10
# File GLTRRF/ACCTXT & upload sementara ditulis di bawah WorkingDirectory
ReadWritePaths=/opt/ausy

[Install]
WantedBy=multi-user.target
