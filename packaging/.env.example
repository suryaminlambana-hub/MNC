# ============================================================
# AUSY — konfigurasi runtime. Salin jadi .env:  cp .env.example .env
# Nilai di bawah cocok dengan setup-db.sql (tinggal pakai).
# ============================================================

# Port HTTP aplikasi (buka http://localhost:<SERVER_PORT><CONTEXT_PATH>)
SERVER_PORT=8080
# Context path aplikasi (sesuai Tech Doc). Kosongkan (CONTEXT_PATH=) untuk akses di root.
CONTEXT_PATH=/ausy

# Koneksi PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ausy
DB_USER=ausy_user
DB_PASS=ausy_pass_2026

# Folder tempat file ACCTXT hasil export dibuat di mesin ini — PATH ABSOLUT. Core banking
# mengambil file dari folder ini, jadi arahkan ke root FTP lokalnya (mis. C:/inetpub/ftproot
# atau /srv/ftp). Pakai garis miring / walau di Windows.
# Kosong / tidak bisa dipakai = bawaan C:/inetpub/ftproot (Windows) atau data/txt (OS lain).
# Folder yang berlaku disebut di log saat start: "File hasil export ditulis ke ...".
AUSY_EXPORT_DIR=

# Server FTP tujuan file ACCTXT (core banking mengambil dari sana). Setelah ditulis ke folder di
# atas, file langsung dikirim ke sini. FTP_HOST kosong = tidak dikirim, cukup folder lokal.
# FTP_DIR kosong = folder awal user FTP.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_DIR=
