# ============================================================
# AUSY — konfigurasi runtime. Salin jadi .env:  cp .env.example .env
# Nilai di bawah cocok dengan setup-db.sql (tinggal pakai).
# ============================================================

# Port HTTP aplikasi (buka http://localhost:<SERVER_PORT><CONTEXT_PATH>)
SERVER_PORT=8080
# Context path aplikasi (sesuai Tech Doc). Kosongkan (CONTEXT_PATH=) untuk akses di root.
CONTEXT_PATH=/ausy

# Koneksi PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ausy
DB_USER=ausy_user
DB_PASS=ausy_pass_2026

# Direktori tujuan file ACCTXT — PATH ABSOLUT. Dua mode pengantaran, pilih salah satu:
#  a. Server FTP ada di MESIN INI: arahkan ke root FTP-nya (mis. C:/inetpub/ftproot atau
#     /srv/ftp) dan biarkan FTP_* kosong — file langsung terbit di sana (BUG_AUSY_00146).
#  b. Server FTP di MESIN LAIN: folder ini cuma tempat file dibuat; isi FTP_HOST/USER/PASS
#     di bawah supaya file-nya dikirim ke sana. Tanpa itu file TIDAK akan pindah sendiri.
# Kosong = data/txt di folder aplikasi. Path yang berlaku disebut di log saat start
# ("File ACCTXT ditulis ke ..."), dan di pesan setelah checker approve export.
AUSY_EXPORT_DIR=

# Push FTP: kosongkan saja kalau tidak dipakai — FTP_HOST kosong sudah berarti MATI, dan baris
# tabel ftp_config peninggalan layar "Konfigurasi FTP" yang lama tidak akan dipakai diam-diam.
# false = matikan tegas. true = hidup, dan boleh memakai baris ftp_config itu kalau FTP_HOST kosong.
FTP_ENABLED=

# Transfer-out GLTRRF ke server FTP/FTPS LAIN (opsional). Diisi di sini, bukan lewat website.
# Lengkapi FTP_HOST/FTP_USER/FTP_PASS di bawah kalau memang mau push FTP; tidak perlu FTP_ENABLED.
# FTP_DIR = folder DI SERVER FTP (mis. /gl), bukan path lokal Windows.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_DIR=
FTP_SECURE=false
FTP_PASSIVE=true
